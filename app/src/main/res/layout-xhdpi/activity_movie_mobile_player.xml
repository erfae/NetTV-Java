<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.exoplayer2.ui.AspectRatioFrameLayout
        android:layout_gravity="center"
        android:id="@+id/video_surface_frame"
        android:background="@color/black"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_centerInParent="true">
        <com.google.android.exoplayer2.ui.StyledPlayerView
            android:layout_gravity="center"
            android:id="@+id/player_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:use_controller="false"/>
    </com.google.android.exoplayer2.ui.AspectRatioFrameLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/ly_control"
        android:background="@drawable/black_gradient_vertical"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <ImageButton
            android:id="@+id/btn_back"
            android:background="@drawable/circle_bg"
            android:padding="@dimen/_3sdp"
            android:nextFocusLeft="@+id/btn_back"
            android:nextFocusRight="@+id/btn_info"
            android:nextFocusUp="@+id/btn_back"
            android:nextFocusDown="@+id/bright_seekbar"
            android:layout_width="@dimen/_22sdp"
            android:layout_height="@dimen/_22sdp"
            android:layout_margin="@dimen/_15sdp"
            android:src="@drawable/image_back_icon"
            android:scaleType="fitXY"
            android:tint="@color/gray"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/btn_resolution"
            android:background="@color/trans_parent"
            android:visibility="visible"
            android:nextFocusLeft="@+id/btn_audio"
            android:nextFocusRight="@+id/btn_resolution"
            android:nextFocusUp="@+id/btn_resolution"
            android:nextFocusDown="@+id/volume_seekbar"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/image_resolution"
            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_back"/>
        <ImageButton
            android:id="@+id/btn_audio"
            android:background="@color/trans_parent"
            android:nextFocusLeft="@+id/btn_sub"
            android:nextFocusRight="@+id/btn_resolution"
            android:nextFocusUp="@+id/btn_audio"
            android:nextFocusDown="@+id/volume_seekbar"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/image_audio"
            android:scaleType="fitCenter"
            android:tint="@color/gray"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back"
            app:layout_constraintEnd_toStartOf="@+id/btn_resolution"
            app:layout_constraintTop_toTopOf="@+id/btn_back"/>
        <ImageButton
            android:id="@+id/btn_sub"
            android:background="@color/trans_parent"
            android:nextFocusLeft="@+id/btn_fav"
            android:nextFocusRight="@+id/btn_audio"
            android:nextFocusUp="@+id/btn_sub"
            android:nextFocusDown="@+id/volume_seekbar"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/image_subtitle"
            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back"
            app:layout_constraintEnd_toStartOf="@+id/btn_audio"
            app:layout_constraintTop_toTopOf="@+id/btn_back"/>
        <ImageButton
            android:id="@+id/btn_fav"
            android:background="@color/trans_parent"
            android:nextFocusLeft="@+id/btn_info"
            android:nextFocusRight="@+id/btn_sub"
            android:nextFocusUp="@+id/btn_fav"
            android:nextFocusDown="@+id/volume_seekbar"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/heart_fav"
            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back"
            app:layout_constraintEnd_toStartOf="@+id/btn_sub"
            app:layout_constraintTop_toTopOf="@+id/btn_back"/>
        <ImageButton
            android:id="@+id/btn_info"
            android:background="@color/trans_parent"
            android:nextFocusLeft="@+id/btn_back"
            android:nextFocusRight="@+id/btn_fav"
            android:nextFocusUp="@+id/btn_info"
            android:nextFocusDown="@+id/volume_seekbar"
            android:layout_width="@dimen/_20sdp"
            android:layout_height="@dimen/_20sdp"
            android:src="@drawable/ic_info"
            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/_10sdp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back"
            app:layout_constraintEnd_toStartOf="@+id/btn_fav"
            app:layout_constraintTop_toTopOf="@+id/btn_back"/>
        <TextView
            android:textSize="@dimen/_13sdp"
            android:textColor="@color/gray"
            android:id="@+id/txt_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="movie name"
            app:layout_constraintBottom_toBottomOf="@+id/btn_back"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/btn_back"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/gray"
            android:id="@+id/txt_end_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_15sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>
        <SeekBar
            android:id="@+id/seekBar"
            android:nextFocusLeft="@+id/seekBar"
            android:nextFocusRight="@+id/seekBar"
            android:nextFocusUp="@+id/btn_play"
            android:nextFocusDown="@+id/seekBar"
            android:layout_width="0sp"
            android:layout_height="wrap_content"
            android:progressDrawable="@drawable/seek_bar"
            android:thumb="@drawable/seek_thumb_selector"
            android:layout_marginStart="@dimen/_10sdp"
            android:layout_marginEnd="@dimen/_10sdp"
            android:progressTint="@color/original_color"
            android:thumbTint="@color/original_color"
            app:layout_constraintBottom_toBottomOf="@+id/txt_end_time"
            app:layout_constraintEnd_toStartOf="@+id/txt_end_time"
            app:layout_constraintStart_toEndOf="@+id/txt_start_time"
            app:layout_constraintTop_toTopOf="@+id/txt_end_time"/>
        <TextView
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/gray"
            android:id="@+id/txt_start_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/_10sdp"
            android:layout_marginStart="@dimen/_15sdp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <View
            android:id="@+id/view_click"
            android:layout_width="match_parent"
            android:layout_height="0sp"
            app:layout_constraintBottom_toTopOf="@+id/seekBar"
            app:layout_constraintTop_toBottomOf="@+id/txt_name"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bright_lay"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="0sp"
            android:paddingEnd="@dimen/_30sdp"
            app:layout_constraintBottom_toTopOf="@+id/seekBar"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_back">
            <ImageView
                android:id="@+id/image_bright"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:src="@drawable/ic_brightness"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/gray"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/bright_seekbar"
                android:nextFocusLeft="@+id/bright_seekbar"
                android:nextFocusRight="@+id/btn_rewind"
                android:nextFocusUp="@+id/btn_back"
                android:nextFocusDown="@+id/seekBar"
                android:layout_width="@dimen/_160sdp"
                android:layout_height="@dimen/_160sdp"
                android:progressDrawable="@drawable/seek_bar"
                android:thumb="@drawable/seek_thumb_selector"
                android:rotation="270"
                android:progressTint="@color/white"
                android:thumbTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_bright"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/volume_lay"
            android:layout_width="@dimen/_100sdp"
            android:layout_height="0sp"
            android:paddingEnd="@dimen/_70sdp"
            app:layout_constraintBottom_toTopOf="@+id/seekBar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/btn_back">
            <ImageView
                android:id="@+id/image_volume"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/_20sdp"
                android:src="@drawable/ic_volume"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/gray"/>
            <androidx.appcompat.widget.AppCompatSeekBar
                android:id="@+id/volume_seekbar"
                android:nextFocusLeft="@+id/btn_forward"
                android:nextFocusRight="@+id/volume_seekbar"
                android:nextFocusUp="@+id/btn_audio"
                android:nextFocusDown="@+id/seekBar"
                android:layout_width="@dimen/_160sdp"
                android:layout_height="@dimen/_160sdp"
                android:progressDrawable="@drawable/seek_bar"
                android:thumb="@drawable/seek_thumb_selector"
                android:rotation="270"
                android:progressTint="@color/white"
                android:thumbTint="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/image_volume"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ImageButton
            android:id="@+id/btn_play"
            android:background="@drawable/circle_bg"
            android:nextFocusLeft="@+id/btn_rewind"
            android:nextFocusRight="@+id/btn_forward"
            android:nextFocusUp="@+id/btn_audio"
            android:nextFocusDown="@+id/seekBar"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:src="@drawable/ic_pause"
            android:scaleType="fitCenter"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageButton
            android:id="@+id/btn_forward"
            android:background="@drawable/circle_bg"
            android:nextFocusLeft="@+id/btn_play"
            android:nextFocusRight="@+id/volume_seekbar"
            android:nextFocusUp="@+id/btn_audio"
            android:nextFocusDown="@+id/seekBar"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:src="@drawable/ic_forward_30"
            android:scaleType="fitCenter"
            android:layout_marginStart="@dimen/_100sdp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_play"
            app:layout_constraintStart_toEndOf="@+id/btn_play"
            app:layout_constraintTop_toTopOf="@+id/btn_play"/>
        <ImageButton
            android:id="@+id/btn_rewind"
            android:background="@drawable/circle_bg"
            android:nextFocusLeft="@+id/bright_seekbar"
            android:nextFocusRight="@+id/btn_play"
            android:nextFocusUp="@+id/btn_back"
            android:nextFocusDown="@+id/seekBar"
            android:layout_width="@dimen/_35sdp"
            android:layout_height="@dimen/_35sdp"
            android:src="@drawable/ic_rewind_30"
            android:scaleType="fitCenter"
            android:layout_marginEnd="@dimen/_100sdp"
            app:layout_constraintBottom_toBottomOf="@+id/btn_play"
            app:layout_constraintEnd_toStartOf="@+id/btn_play"
            app:layout_constraintTop_toTopOf="@+id/btn_play"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
